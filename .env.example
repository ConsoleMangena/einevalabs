APP_NAME="EINEVA Labs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Set to false only if the site is genuinely served over http.
APP_FORCE_HTTPS=true

# cPanel usually sits behind a proxy/CDN. "*" is correct for a single-tenant
# host. Pin it to the proxy's address (e.g. 10.0.0.1) if the site is ever
# behind an intermediary you do not control - trusting every hop lets a client
# spoof X-Forwarded-For and defeat the IP rate limiters.
TRUSTED_PROXIES=*

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_db_name
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
# The cart and the pending-order reference live in the session, so it is
# encrypted at rest.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Product and post images must be served from the public disk via
# `php artisan storage:link`. "local" is the default disk used for framework
# internals; "public" is the one uploads are written to.
FILESYSTEM_DISK=local

# Contact-form and newsletter notifications are pushed onto the queue, so this
# needs `php artisan queue:work` running as a daemon. "sync" executes them
# inline in the web request instead, which works but makes the visitor wait on
# a third-party HTTP call.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Filament admin panel
# ---------------------------------------------------------------------------
# Used only by `php artisan db:seed` to create the first administrator.
# After the account exists the seeder leaves its password alone, so this can
# be removed from the deployed .env.
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# PesePay (checkout)
# ---------------------------------------------------------------------------
# Both keys must be exactly 16, 24 or 32 characters. Checkout refuses to
# start if they are not.
#
# PESEPAY_SANDBOX=true points at api.test.sandbox.pesepay.com. Use it until a
# real payment has been confirmed end to end.
PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=
PESEPAY_SANDBOX=true
PESEPAY_CURRENCY=USD
PESEPAY_REASON="EINEVA Labs Store Checkout"
PESEPAY_CONNECT_TIMEOUT=10
PESEPAY_TIMEOUT=30

# ---------------------------------------------------------------------------
# Web3Forms (contact form / newsletter notifications)
# ---------------------------------------------------------------------------
# These replaced hardcoded credentials that were committed to the repository.
# The old values must be rotated in the Web3Forms dashboard.
WEB3FORMS_ACCESS_KEY=
WEB3FORMS_ENDPOINT=https://api.web3forms.com/submit
WEB3FORMS_TIMEOUT=10
